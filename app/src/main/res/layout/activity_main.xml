<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/screen" style="@style/Screen" android:orientation="vertical">
    <TextView style="@style/Label" android:text="@string/activity_main_text_1" android:textColor="@color/primary" android:layout_marginTop="0dp"/>
    <TextView style="@style/Heading" android:text="@string/activity_main_text_2"/>
    <TextView style="@style/Body" android:text="@string/activity_main_text_3"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:background="@drawable/stats_background">
        <TextView style="@style/Heading" android:text="@string/activity_main_text_4" android:id="@+id/totalCount" android:textColor="@color/surface" android:textSize="26sp"/>
        <TextView style="@style/Body" android:text="@string/activity_main_text_5" android:id="@+id/favoriteCount" android:textColor="@color/surface"/>
    </LinearLayout>
    <TextView style="@style/Label" android:text="@string/activity_main_text_6" android:layout_marginTop="8dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/contactList" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="10dp" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="8dp"/>
        <TextView style="@style/Body" android:text="@string/empty_contacts" android:id="@+id/emptyContacts" android:gravity="center" android:padding="24dp"/>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton style="@style/Action" android:id="@+id/addContactButton" android:text="@string/add_contact"/>
</LinearLayout>
